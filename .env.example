# Required
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_URL=https://your-domain.com/zalo-webhook
ZALO_WEBHOOK_SECRET=
OPENAI_API_KEY=

# Important
AI_PROVIDER=API
OPENAI_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=8
AGENT_STATE_FILE=artifacts/agent_state.json
ZALO_HOST=0.0.0.0
ZALO_PORT=8000

# Optional: Zalo API endpoint override
ZALO_SEND_MESSAGE_URL=https://openapi.zalo.me/v3.0/oa/message/cs

# Google Sheets
GCP_SERVICE_ACCOUNT_JSON=
# GCP_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GCP_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets

# Webhook secret options
ZALO_ALLOW_QUERY_SECRET=0
ZALO_ALLOW_BODY_SECRET=1
ZALO_WEBHOOK_SECRET_HEADERS=x-zalo-secret,x-webhook-secret
ZALO_WEBHOOK_SECRET_FIELDS=secret,webhook_secret
