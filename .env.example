# Required
# You can use BOT_TOKEN or ZALO_BOT_TOKEN
BOT_TOKEN=
ZALO_BOT_TOKEN=
# You can use WEBHOOK_URL or ZALO_WEBHOOK_URL
WEBHOOK_URL=
ZALO_WEBHOOK_URL=https://your-domain.com/webhook
# You can use WEBHOOK_SECRET_TOKEN or ZALO_WEBHOOK_SECRET
WEBHOOK_SECRET_TOKEN=
ZALO_WEBHOOK_SECRET=
# API mode only
OPENAI_API_KEY=

# Important
AI_PROVIDER=BROWSER
OPENAI_MODEL=gpt-4o-mini
AGENT_MAX_STEPS=8
AGENT_STATE_FILE=artifacts/agent_state.json
ZALO_HOST=0.0.0.0
ZALO_PORT=8000

# Browser ChatGPT mode
PLAYWRIGHT_CLI_BIN=
CHATGPT_URL=https://chatgpt.com/
CHATGPT_SESSION=zalo-agent
CHATGPT_BROWSER_HEADED=0
CHATGPT_RESPONSE_TIMEOUT_MS=180000
CHATGPT_IDLE_POLL_MS=1200
CHATGPT_PROMPT_SELECTOR=textarea[data-testid='prompt-textarea'], textarea#prompt-textarea, textarea
CHATGPT_RESPONSE_SELECTOR=[data-message-author-role='assistant']

# Google Sheets
GCP_SERVICE_ACCOUNT_JSON=
# GCP_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
GCP_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets
